# Copy to deploy/.env and fill in. Never commit the real .env.

# Database password (any long random string).
PE_DB_PASSWORD=change-me

# Version of the app image to run (see the releases on GitHub).
PE_VERSION=latest

# Department policy: high risk when the risk of PE <37 weeks is 1 in N or higher.
PE_CUTOFF_ONE_IN=100

# Sign-in with Vinmec accounts.
PE_AUTH_MODE=ldap
PE_LDAP_URL=ldaps://dc01.vinmec.local
PE_LDAP_BIND_DN=CN=svc-pe-risk,OU=Service Accounts,DC=vinmec,DC=local
PE_LDAP_BIND_PASSWORD=change-me
PE_LDAP_BASE_DN=DC=vinmec,DC=local
PE_LDAP_USER_FILTER=(sAMAccountName={username})
PE_LDAP_GROUP_SONOGRAPHER=CN=PE-Sonographers,OU=Groups,DC=vinmec,DC=local
PE_LDAP_GROUP_DOCTOR=CN=PE-Doctors,OU=Groups,DC=vinmec,DC=local
PE_LDAP_GROUP_ADMIN=CN=PE-Admins,OU=Groups,DC=vinmec,DC=local

# Sign out after this many idle minutes.
PE_SESSION_IDLE_MINUTES=15

# Key for the pseudonymous patient number in research exports (long random string; keep it the same).
PE_EXPORT_SALT=change-me
