# Copy to deploy/cloud/.env and fill in. Never commit the real .env.

# The web address (a domain or subdomain whose DNS "A" record points to this server's public IP).
PE_DOMAIN=tsg.example.vn
# Email for Let's Encrypt certificate notices.
PE_ACME_EMAIL=it@example.vn

# Database password (long random string: openssl rand -base64 32).
PE_DB_PASSWORD=change-me

# Version of the app image to run.
PE_VERSION=latest

# Department policy: high risk when the risk of PE <37 weeks is 1 in N or higher.
PE_CUTOFF_ONE_IN=100

# Sign out after this many idle minutes.
PE_SESSION_IDLE_MINUTES=15

# Key for the pseudonymous patient number in research exports (long random string; keep it the same).
PE_EXPORT_SALT=change-me
