# Caddy gets and renews the HTTPS certificate for PE_DOMAIN by itself (Let's Encrypt).
{
	email {$PE_ACME_EMAIL}
}

{$PE_DOMAIN} {
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; frame-ancestors 'none'"
		-Server
	}
	reverse_proxy app:8000
}
